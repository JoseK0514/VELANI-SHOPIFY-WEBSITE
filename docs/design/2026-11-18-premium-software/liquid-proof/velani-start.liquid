<section class="vs-start" aria-labelledby="vs-start-{{ section.id }}">
  <div class="vs-wrap">
    <h2 id="vs-start-{{ section.id }}" class="vs-start__title">{{ section.settings.heading | escape }}</h2>
    {%- if section.settings.subheading != blank -%}
      <p class="vs-start__sub">{{ section.settings.subheading | escape }}</p>
    {%- endif -%}
    <velani-steps>
      <ol class="vs-start__track" style="--steps: {{ section.blocks.size }}">
        {%- for block in section.blocks -%}
          <li class="vs-start__step" {{ block.shopify_attributes }}>
            <p class="vs-start__when">{{ block.settings.when | escape }}</p>
            <h3 class="vs-start__name">{{ block.settings.title | escape }}</h3>
            <p class="vs-start__text">{{ block.settings.text | escape }}</p>
          </li>
        {%- endfor -%}
      </ol>
    </velani-steps>
    {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
      <p class="vs-start__acts"><a class="vs-btn" href="{{ section.settings.button_link }}">{{ section.settings.button_label | escape }}</a></p>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
.vs-start { padding-block: clamp(110px, 13vw, 180px); }
.vs-start__title { text-align: center; font-size: clamp(44px, 6vw, 80px); line-height: 1; letter-spacing: -0.048em; margin: 0; }
.vs-start__sub { text-align: center; margin: 16px auto 0; max-width: 34ch; font-size: clamp(19px, 1.8vw, 24px); color: var(--ink-2); }
.vs-start__track { position: relative; list-style: none; padding: 0; margin: 72px auto 0; max-width: 1080px; display: grid; grid-template-columns: repeat(var(--steps), minmax(0, 1fr)); gap: 28px; }
.vs-start__track::before, .vs-start__track::after { content: ""; position: absolute; left: 12px; top: 11px; height: 2px; border-radius: 1px; }
.vs-start__track::before { right: calc((100% - (var(--steps) - 1) * 28px) / var(--steps) - 12px); background: #dce3e2; }
.vs-start__track::after { width: calc(((var(--steps) - 1) * (100% - (var(--steps) - 1) * 28px) / var(--steps) + (var(--steps) - 1) * 28px) * var(--sp, 1)); background: var(--teal); }
.vs-start__step { position: relative; padding-top: 44px; }
.vs-start__step::before { content: ""; position: absolute; left: 0; top: 0; width: 24px; height: 24px; border-radius: 50%; background: #fff; box-shadow: inset 0 0 0 2px #c9d3d1; z-index: 1; transition-property: background-color, box-shadow; transition-duration: 0.4s; }
.vs-start__step.is-lit::before { background: var(--teal); box-shadow: inset 0 0 0 6px #fff, 0 0 0 2px var(--teal); }
.vs-start__when { margin: 0; font-size: 14px; font-weight: 600; color: var(--teal); }
.vs-start__name { margin: 6px 0 0; font-size: clamp(21px, 1.9vw, 26px); letter-spacing: -0.03em; }
.vs-start__text { margin: 8px 0 0; font-size: 16px; line-height: 1.45; color: var(--ink-2); }
.vs-start__acts { margin-top: 64px; text-align: center; }
@media (max-width: 820px) {
  .vs-start__track { grid-template-columns: minmax(0, 1fr); gap: 36px; padding-left: 44px; }
  .vs-start__track::before, .vs-start__track::after { left: 11px; right: auto; top: 12px; width: 2px; }
  .vs-start__track::before { bottom: 12px; height: auto; }
  .vs-start__track::after { height: calc((100% - 24px) * var(--sp, 1)); }
  .vs-start__step { padding-top: 0; }
  .vs-start__step::before { left: -44px; }
}
{% endstylesheet %}

{% javascript %}
class VelaniSteps extends HTMLElement {
  connectedCallback() {
    this.track = this.querySelector('ol');
    this.steps = Array.from(this.querySelectorAll('li'));
    this.still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    this.onScroll = () => requestAnimationFrame(() => this.update());
    window.addEventListener('scroll', this.onScroll, { passive: true });
    this.update();
  }
  disconnectedCallback() {
    window.removeEventListener('scroll', this.onScroll);
  }
  update() {
    const r = this.track.getBoundingClientRect();
    const vh = window.innerHeight;
    const p = this.still ? 1 : Math.min(1, Math.max(0, (vh * 0.85 - r.top) / (vh * 0.5)));
    this.track.style.setProperty('--sp', p.toFixed(3));
    const last = Math.max(1, this.steps.length - 1);
    this.steps.forEach((s, i) => s.classList.toggle('is-lit', p >= i / last - 0.02));
  }
}
if (!customElements.get('velani-steps')) customElements.define('velani-steps', VelaniSteps);
{% endjavascript %}

{% schema %}
{
  "name": "How starting works",
  "tag": "div",
  "class": "velani-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "How starting works." },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "A person sets you up. Nothing is charged until you pick a plan." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Request a free trial" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "when", "label": "When", "default": "Today" },
        { "type": "text", "id": "title", "label": "Title", "default": "Request a free trial" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Tell us about your team and your locations." }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "How starting works",
      "blocks": [
        { "type": "step", "settings": { "when": "Today", "title": "Request a free trial", "text": "Tell us about your team and your locations." } },
        { "type": "step", "settings": { "when": "Within two business days", "title": "Jose replies", "text": "You get a real reply from Velani, in English or Spanish." } },
        { "type": "step", "settings": { "when": "Setup day", "title": "Set up together", "text": "Jose sets up your workplace with you, then your team gets their accounts." } },
        { "type": "step", "settings": { "when": "Day 30", "title": "Pick a plan", "text": "$19 or $29 a month. If you don't pick one, NEVORA pauses. No card until then." } }
      ]
    }
  ]
}
{% endschema %}
