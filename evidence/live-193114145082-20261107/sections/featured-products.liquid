<section class="featured-products section-shell">
  <div class="page-width">
    <div class="section-heading">
      <div><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2 class="section-title">{{ section.settings.heading }}</h2></div>
      <div class="section-intro">{{ section.settings.text }}</div>
    </div>
    <div class="product-grid">
      {% if section.settings.collection != blank and section.settings.collection.products_count > 0 %}
        {% for product in section.settings.collection.products limit: section.settings.products_to_show %}{% render 'product-card', product: product %}{% endfor %}
      {% else %}
        {% assign demo_titles = 'The Everyday Collar|The Standard Leash|Heritage Bandana|The Cat Collar' | split: '|' %}
        {% assign demo_types = 'Dog collars|Dog leashes|Bandanas|Cat accessories' | split: '|' %}
        {% assign demo_images = 'velani-collars.png|velani-hero.png|velani-bandanas.png|velani-cat-collars.png' | split: '|' %}
        {% for title in demo_titles %}
          <article class="product-card"><div class="product-card__media"><img src="{{ demo_images[forloop.index0] | asset_url }}" alt="{{ title }}" width="900" height="900" loading="lazy"></div><p class="product-card__category">{{ demo_types[forloop.index0] }}</p><div class="product-card__meta"><h3>{{ title }}</h3><span class="product-card__price">Add products in Shopify</span></div></article>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured products",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Signature pieces" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Icons for everyday life." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Every product begins with real life: how it is worn, held, adjusted and made part of a routine.</p>" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "min": 2, "max": 8, "step": 1, "label": "Products to show", "default": 4 }
  ],
  "presets": [{ "name": "Featured products" }]
}
{% endschema %}
