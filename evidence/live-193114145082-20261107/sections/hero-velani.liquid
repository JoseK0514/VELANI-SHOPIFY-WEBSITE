<section class="hero-velani">
  <div class="hero-velani__copy">
    {% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
    <h1 class="display">{{ section.settings.heading }}</h1>
    <div class="hero-velani__text">{{ section.settings.text }}</div>
    <div class="hero-velani__buttons">
      {% if section.settings.primary_label != blank %}<a class="button button--primary" href="{{ section.settings.primary_link | default: routes.all_products_collection_url }}">{{ section.settings.primary_label }}</a>{% endif %}
      {% if section.settings.secondary_label != blank %}<a class="button" href="{{ section.settings.secondary_link | default: '/pages/our-story' }}">{{ section.settings.secondary_label }}</a>{% endif %}
    </div>
  </div>
  <div class="hero-velani__media">
    {% if section.settings.image != blank %}
      {{ section.settings.image | image_url: width: 2200 | image_tag: widths: '750,1100,1600,2200', sizes: '(min-width: 750px) 58vw, 100vw', loading: 'eager', fetchpriority: 'high', alt: section.settings.image.alt }}
    {% else %}
      <img src="{{ 'velani-hero.png' | asset_url }}" alt="Golden retriever wearing a Velani collar and leash" width="1350" height="1350" fetchpriority="high">
    {% endif %}
    <div class="hero-velani__caption"><span>{{ section.settings.caption }}</span><span>Velani · 2026</span></div>
  </div>
</section>
{% if section.settings.show_ticker %}<div class="brand-ticker"><span>For the walks.</span><i></i><span>For the routines.</span><i></i><span>For the memories.</span><i></i><span>For the life you share.</span></div>{% endif %}

{% schema %}
{
  "name": "Velani hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The first Velani collection" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Life, better together." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Modern essentials for the walks, routines and moments that make a life together.</p>" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "caption", "label": "Image caption", "default": "Everyday, considered." },
    { "type": "text", "id": "primary_label", "label": "Primary button", "default": "Explore the collection" },
    { "type": "url", "id": "primary_link", "label": "Primary button link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary button", "default": "The world of Velani" },
    { "type": "url", "id": "secondary_link", "label": "Secondary button link" },
    { "type": "checkbox", "id": "show_ticker", "label": "Show message strip", "default": true }
  ],
  "presets": [{ "name": "Velani hero" }]
}
{% endschema %}
