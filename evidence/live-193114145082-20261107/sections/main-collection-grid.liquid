<header class="collection-hero"><p class="eyebrow">Velani collection</p><h1 class="display">{{ collection.title }}</h1>{% if collection.description != blank %}<div>{{ collection.description }}</div>{% endif %}</header>
<section class="collection-product-grid page-width">
  {% paginate collection.products by section.settings.products_per_page %}
    <div class="product-grid">{% for product in collection.products %}{% render 'product-card', product: product %}{% else %}<p>No products have been added to this collection yet.</p>{% endfor %}</div>
    {% if paginate.pages > 1 %}<nav class="pagination" aria-label="Pagination">{{ paginate | default_pagination }}</nav>{% endif %}
  {% endpaginate %}
</section>

{% schema %}
{
  "name": "Collection product grid",
  "settings": [
    { "type": "range", "id": "products_per_page", "min": 6, "max": 24, "step": 3, "label": "Products per page", "default": 12 }
  ]
}
{% endschema %}
