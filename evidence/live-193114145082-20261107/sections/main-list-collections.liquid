<section class="section-shell page-width"><div class="section-heading"><div><p class="eyebrow">Velani</p><h1 class="section-title">Shop all collections.</h1></div></div><div class="collection-cards">{% for collection in collections %}<a class="collection-card" href="{{ collection.url }}">{% if collection.featured_image %}{{ collection.featured_image | image_url: width: 1200 | image_tag: widths: '500,800,1200', loading: 'lazy', alt: collection.featured_image.alt }}{% else %}{{ 'collection-1' | placeholder_svg_tag }}{% endif %}<span class="collection-card__shade"></span><span class="collection-card__content"><h3>{{ collection.title }}</h3><span class="collection-card__copy">{{ collection.description | strip_html | truncatewords: 18 }}</span><span class="collection-card__link">Shop collection →</span></span></a>{% endfor %}</div></section>
{% schema %}{ "name": "Collection list", "settings": [] }{% endschema %}
