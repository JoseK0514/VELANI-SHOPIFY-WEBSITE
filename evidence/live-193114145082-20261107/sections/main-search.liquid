<section class="search-main page-width">
  <h1 class="display">{{ 'search.title' | t }}</h1>
  <form class="search-form" action="{{ routes.search_url }}" method="get" role="search"><label class="visually-hidden" for="SearchInput">{{ 'search.placeholder' | t }}</label><input id="SearchInput" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'search.placeholder' | t }}"><input type="hidden" name="options[prefix]" value="last"><button type="submit">{{ 'general.search' | t }} →</button></form>
  {% if search.performed %}
    {% paginate search.results by 12 %}
      <div class="search-results">
        {% for item in search.results %}
          {% if item.object_type == 'product' %}{% render 'product-card', product: item %}{% else %}<article><p class="eyebrow">{{ item.object_type }}</p><h2><a href="{{ item.url }}">{{ item.title }}</a></h2><p>{{ item.content | strip_html | truncatewords: 24 }}</p></article>{% endif %}
        {% else %}<p>{{ 'search.no_results' | t }}</p>{% endfor %}
      </div>
      {% if paginate.pages > 1 %}<nav class="pagination" aria-label="Pagination">{{ paginate | default_pagination }}</nav>{% endif %}
    {% endpaginate %}
  {% endif %}
</section>
{% schema %}{ "name": "Main search", "settings": [] }{% endschema %}
