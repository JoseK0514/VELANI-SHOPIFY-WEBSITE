<section class="story-split">
  <div class="story-split__media">
    {% if section.settings.image != blank %}
      {{ section.settings.image | image_url: width: 1800 | image_tag: widths: '750,1100,1400,1800', sizes: '(min-width: 750px) 55vw, 100vw', loading: 'lazy', alt: section.settings.image.alt }}
    {% else %}
      <img src="{{ 'velani-bandanas.png' | asset_url }}" alt="Velani heritage bandana collection" width="1402" height="1128" loading="lazy">
    {% endif %}
  </div>
  <div class="story-split__copy">
    <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    <h2 class="section-title">{{ section.settings.heading }}</h2>
    <div class="story-split__body">{{ section.settings.text }}</div>
    {% if section.settings.quote != blank %}<blockquote>“{{ section.settings.quote }}”</blockquote>{% endif %}
    <p class="story-split__signature">{{ section.settings.signature }}<br><span>{{ section.settings.role }}</span></p>
    {% if section.settings.link_label != blank %}<a class="arrow-link" href="{{ section.settings.link | default: '/pages/our-story' }}">{{ section.settings.link_label }} →</a>{% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Story split",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The house of Velani" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A house built on connection." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>The products we use with our pets become part of the way we live together. Velani brings a fresh point of view to those everyday essentials—combining clean design, useful details and a deep appreciation for the relationship behind every choice.</p>" },
    { "type": "text", "id": "quote", "label": "Quote", "default": "Because they were never just a pet. They are family." },
    { "type": "text", "id": "signature", "label": "Signature", "default": "Jose Natal" },
    { "type": "text", "id": "role", "label": "Role", "default": "Founder, Velani" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Discover our story" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "presets": [{ "name": "Story split" }]
}
{% endschema %}
