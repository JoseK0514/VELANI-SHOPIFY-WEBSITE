svg class="icon" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" fill="currentColor"><path d="M221.66,133.66l-72,72a8,8,0,0,1-11.32-11.32L196.69,136H40a8,8,0,0,1,0-16H196.69L138.34,61.66a8,8,0,0,1,11.32-11.32l72,72A8,8,0,0,1,221.66,133.66Z"/></svg></a><a class="hb" href="{% if theme.role == 'main' %}/pages/help{% else %}{{ routes.root_url }}?preview_theme_id={{ theme.id }}&amp;view=velani-help{% endif %}">Client support<svg class="icon" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" fill="currentColor"><path d="M221.66,133.66l-72,72a8,8,0,0,1-11.32-11.32L196.69,136H40a8,8,0,0,1,0-16H196.69L138.34,61.66a8,8,0,0,1,11.32-11.32l72,72A8,8,0,0,1,221.66,133.66Z"/></svg></a></div></div></section>
<script>
/* Client screenshots: tap or click to see the whole screen. On phones a desktop screenshot opens at a readable height and pans sideways */
(() => {
  const imgs = [...document.querySelectorAll('.hpanel .hwin img, .hpanel .hduo .ph img')];
  if (!imgs.length || !window.HTMLDialogElement) return;
  const out = '<svg class="icon" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" fill="currentColor"><path d="M216,48V96a8,8,0,0,1-16,0V67.31l-50.34,50.35a8,8,0,0,1-11.32-11.32L188.69,56H160a8,8,0,0,1,0-16h48A8,8,0,0,1,216,48ZM106.34,138.34,56,188.69V160a8,8,0,0,0-16,0v48a8,8,0,0,0,8,8H96a8,8,0,0,0,0-16H67.31l50.35-50.34a8,8,0,0,0-11.32-11.32Z"/></svg>';
  const x = '<svg class="icon" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" fill="currentColor"><path d="M205.66,194.34a8,8,0,0,1-11.32,11.32L128,139.31,61.66,205.66a8,8,0,0,1-11.32-11.32L116.69,128,50.34,61.66A8,8,0,0,1,61.66,50.34L128,116.69l66.34-66.35a8,8,0,0,1,11.32,11.32L139.31,128Z"/></svg>';
  const d = document.createElement('dialog');
  d.className = 'zoom'; d.tabIndex = -1; d.setAttribute('aria-label', 'Screenshot');
  d.innerHTML = '<button class="zoom-x" type="button" aria-label="Close">' + x + '</button><div class="zoom-sc" role="region" aria-label="Screenshot, scrollable"><img alt="" decoding="async"></div><p class="zoom-cap"></p><p class="zoom-tip" aria-hidden="true">Swipe to see the whole screen</p>';
  document.body.append(d);
  const sc = d.querySelector('.zoom-sc'), big = sc.querySelector('img'), cap = d.querySelector('.zoom-cap');
  let opener;
  // The picture area is a keyboard stop only while it actually scrolls (a wide screenshot on a phone)
  const syncScroll = () => { if (sc.scrollWidth > sc.clientWidth + 1 || sc.scrollHeight > sc.clientHeight + 1) sc.tabIndex = 0; else sc.removeAttribute('tabindex'); };
  addEventListener('resize', () => { if (d.open) syncScroll(); });
  for (const img of imgs) {
    const host = img.closest('.hwin, .ph');
    const b = document.createElement('button');
    b.type = 'button'; b.className = 'zoom-btn'; b.setAttribute('aria-label', 'View full screen: ' + img.alt); b.innerHTML = out;
    host.classList.add('can-zoom'); host.append(b);
    b.addEventListener('click', () => {
      opener = b;
      big.width = img.naturalWidth || img.width; big.height = img.naturalHeight || img.height;
      big.src = img.currentSrc || img.src; big.alt = img.alt; cap.textContent = img.alt;
      d.classList.toggle('wide', (img.naturalWidth || img.width) > (img.naturalHeight || img.height));
      d.showModal(); d.focus(); sc.scrollLeft = 0;
      if (big.complete) syncScroll(); else big.addEventListener('load', syncScroll, { once: true });
    });
  }
  d.querySelector('.zoom-x').addEventListener('click', () => d.close());
  d.addEventListener('click', e => { if (e.target === d) d.close(); });
  d.addEventListener('close', () => { if (opener?.isConnected) opener.focus({ preventScroll: true }); });
})();
</script>
