<section class="chap rondo" id="rondo" aria-labelledby="rondo-t">
 <div class="wrap">
  <div class="rondo-grid">
   <div class="rondo-copy">
    <p class="hkick rondo-kick"><b class="rmark rondo-mark" aria-hidden="true"><svg viewBox="0 0 32 32" focusable="false"><circle cx="16" cy="16" r="14.25"/><path d="M16 1.75A14.25 14.25 0 1 1 1.75 16"/></svg>R</b>Rondo&nbsp;· NEVORA’s AI assistant</p>
