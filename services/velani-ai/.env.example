NODE_ENV=development
PORT=3001

# Application role, pooled Neon URL. Use verify-full for TCP TLS.
DATABASE_URL=postgresql://velani_ai_app:REPLACE@YOUR-ENDPOINT-pooler.us-east-1.aws.neon.tech/velani_ai?sslmode=verify-full
# Owner URL used only by administration jobs; omit from the running web service.
DATABASE_URL_UNPOOLED=postgresql://OWNER:REPLACE@YOUR-ENDPOINT.us-east-1.aws.neon.tech/velani_ai?sslmode=verify-full

# Server secrets only. Neon gateway URL needs /v1 for OpenAI compatibility.
AI_API_KEY=REPLACE
AI_BASE_URL=https://YOUR-BRANCH-api.ai.c-16.us-east-1.aws.neon.tech/v1
# Confirm availability with GET $AI_BASE_URL/models. No automatic cheaper fallback.
AI_MODEL=gpt-6-astra
# Optional independent model for longer workflow plans; defaults to AI_MODEL.
AI_PLAN_MODEL=gpt-6-astra
MODEL_TIMEOUT_MS=45000
SESSION_HASH_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
SESSION_TTL_HOURS=24
DAILY_AI_REQUEST_LIMIT=500

ALLOWED_ORIGINS=https://www.thevelani.com,https://thevelani.com,https://x19hvn-ar.myshopify.com,http://localhost:8080
# false, or an explicit comma-separated trusted ingress IP/CIDR list. Never true.
TRUST_PROXY=false
# Production requires true, a real Turnstile secret and HTTPS-only origins.
REQUIRE_CAPTCHA=false
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=

# Optional for runtimes where direct PostgreSQL TCP is unavailable.
NEON_WEBSOCKET=false
NEON_USE_PROXY=false

# Production Vercel cron secret: store as Sensitive, production target only.
# Generate at least 32 random characters; never expose this to browser code.
CRON_SECRET=

# Client hub: own restricted role in Velani's database, not NEVORA production.
# Keep false until Resend SPF/DKIM and sending capacity are verified.
CLIENT_HUB_ENABLED=false
CLIENT_HUB_DATABASE_URL=
CLIENT_HUB_ALLOWED_ORIGINS=https://www.thevelani.com,https://thevelani.com,https://x19hvn-ar.myshopify.com
RESEND_API_KEY=

# Manual administration job defaults; scheduled chat cleanup is fixed at 30 days.
CHAT_RETENTION_DAYS=30
LEAD_RETENTION_DAYS=90
