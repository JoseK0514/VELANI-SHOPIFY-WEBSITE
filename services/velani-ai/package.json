{
  "name": "velani-ai-backend",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/src/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "retention": "tsx --env-file-if-exists=.env scripts/retention.ts",
    "operations:check": "tsx scripts/operations-check.ts",
    "eval": "tsx --env-file-if-exists=.env scripts/evaluate.ts",
    "provision:role": "tsx --env-file-if-exists=.env scripts/provision-app-role.ts",
    "leads": "tsx --env-file-if-exists=.env scripts/leads.ts",
    "compare:models": "tsx --env-file-if-exists=.env scripts/compare-models.ts",
    "smoke:experience": "tsx --env-file-if-exists=.env scripts/experience-smoke.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "@neondatabase/serverless": "^1.2.0",
    "@vercel/queue": "0.11.0",
    "fastify": "^5.0.0",
    "https-proxy-agent": "^9.1.0",
    "openai": "^6.0.0",
    "pg": "^8.13.0",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.0",
    "@types/ws": "^8.18.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "4.1.12"
  },
  "overrides": {
    "@vercel/cli-config": {
      "zod": "4.6.7"
    },
    "@vercel/queue": {
      "minimatch": "11.0.1"
    }
  }
}
