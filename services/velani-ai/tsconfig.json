{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "esModuleInterop": true, "skipLibCheck": true,
    "outDir": "dist", "rootDir": ".", "resolveJsonModule": true
  },
  "include": ["api/**/*.ts", "src/**/*.ts", "scripts/**/*.ts", "test/**/*.ts", "functions/**/*.ts"]
}
